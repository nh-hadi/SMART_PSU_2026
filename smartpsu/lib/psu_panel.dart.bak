/// Custom Painter: White Dial Gauge 0 - 2A persis seperti di gambar user
/// Skala: 0, 0.25, 0.5, 0.75, 1 (Merah), 1.25, 1.5, 1.75, 2 (Merah)
class _WaveformSampWhiteGaugePainter extends CustomPainter {
  final double currentAmp;  const _WaveformSampWhiteGaugePainter({
    required this.currentAmp,
  });

  @override
  void paint(Canvas canvas, Size size) {
    if (size.width <= 0 || size.height <= 0) return;

    // Di Halaman 3, meter analog hanya menempati kolom kiri (sekitar 45% lebar layar)
    // Di Halaman 2, agar persis sama dengan Halaman 3, targetWidth diambil ~45% dari size.width
    final double targetWidth = size.width * 0.45;
    final double scale = targetWidth / 495.0;

    final double cx = size.width / 2.0;

    final double rArc = 295.0 * scale;
    final double rTickStart = 295.0 * scale;
    final double rTickMinorEnd = 303.0 * scale;
    final double rTickMidEnd = 309.0 * scale;
    final double rTickMajorEnd = 317.0 * scale;
    final double rText = 344.0 * scale;

    // Batas atas angka di bawah panel header (margin 18px), persis halaman 3
    final double cy = rText + 18.0;

    const double startAngle = -46.0;
    const double endAngle = 46.0;
    const double totalRange = endAngle - startAngle;

    // Helper: Polar to Cartesian (0 derajat di atas, searah jarum jam)
    Offset polarToCartesian(double centerX, double centerY, double radius, double angleInDegrees) {
      final double angleInRadians = (angleInDegrees - 90.0) * math.pi / 180.0;
      return Offset(
        centerX + (radius * math.cos(angleInRadians)),
        centerY + (radius * math.sin(angleInRadians)),
      );
    }

    // 1. Menggambar Garis Busur Utama (Arc)
    final double startRad = (startAngle - 90.0) * math.pi / 180.0;
    final double sweepRad = totalRange * math.pi / 180.0;

    final arcPaint = Paint()
      ..color = const Color(0xFF1E293B)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.5 * scale
      ..strokeCap = StrokeCap.round;

    canvas.drawArc(
      Rect.fromCircle(center: Offset(cx, cy), radius: rArc),
      startRad,
      sweepRad,
      false,
      arcPaint,
    );

    // 2. Skala Ticks (0 s/d 2.0A) - 40 divisi (setiap 0.05A)
    const int totalDivisions = 40;
    const double maxScale = 2.0;

    for (int i = 0; i <= totalDivisions; i++) {
      final double angle = startAngle + (i / totalDivisions) * totalRange;

      final bool isMajor = (i % 10 == 0); // 0, 0.5, 1.0, 1.5, 2.0
      final bool isMid = (i % 5 == 0 && !isMajor); // 0.25, 0.75, 1.25, 1.75
      final bool isRedTick = (i == 0 || i == 20 || i == 40); // 0, 1, 2 aksen merah

      final double rEnd = isMajor ? rTickMajorEnd : (isMid ? rTickMidEnd : rTickMinorEnd);

      final p1 = polarToCartesian(cx, cy, rTickStart, angle);
      final p2 = polarToCartesian(cx, cy, rEnd, angle);

      final tickPaint = Paint()
        ..color = isRedTick
            ? const Color(0xFFDC2626)
            : (isMajor ? const Color(0xFF0F172A) : const Color(0xFF475569))
        ..strokeWidth = (isMajor ? 2.5 : (isMid ? 1.8 : 1.2)) * scale
        ..strokeCap = StrokeCap.round;

      canvas.drawLine(p1, p2, tickPaint);

      // Angka Skala Lengkap: 0, 0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2
      if (isMajor || isMid) {
        final double val = (i / totalDivisions) * maxScale;
        String labelText;
        if (val == 0.0) {
          labelText = '0';
        } else if (val == 1.0) {
          labelText = '1';
        } else if (val == 2.0) {
          labelText = '2';
        } else if (val == 0.5) {
          labelText = '0.5';
        } else if (val == 1.5) {
          labelText = '1.5';
        } else {
          labelText = val.toStringAsFixed(2);
        }

        final pText = polarToCartesian(cx, cy, rText, angle);

        final tp = TextPainter(
          text: TextSpan(
            text: labelText,
            style: TextStyle(
              color: isRedTick ? const Color(0xFFDC2626) : const Color(0xFF0F172A),
              fontSize: (isMajor ? 16.5 : 11.5) * scale,
              fontWeight: FontWeight.w900,
              fontFamily: 'monospace',
            ),
          ),
          textDirection: TextDirection.ltr,
        )..layout();

        // Rotasi angka selaras sudut busur persis seperti di SVG Halaman 3
        canvas.save();
        canvas.translate(pText.dx, pText.dy);
        canvas.rotate(angle * math.pi / 180.0);
        tp.paint(canvas, Offset(-tp.width / 2, -tp.height / 2));
        canvas.restore();
      }
    }

    // Label Unit Ampere di atas poros jarum
    final unitTp = TextPainter(
      text: TextSpan(
        text: 'AMPERE (MAX 2.0A)',
        style: TextStyle(
          color: const Color(0xFF64748B),
          fontSize: 10.0 * scale,
          letterSpacing: 1.0,
          fontWeight: FontWeight.bold,
          fontFamily: 'monospace',
        ),
      ),
      textDirection: TextDirection.ltr,
    )..layout();
    unitTp.paint(canvas, Offset(cx - (unitTp.width / 2), cy - (rArc * 0.45)));

    // 3. Menggambar Jarum (Needle) dengan Ekor/Titik Bawah Over ke Bawah
    final double clampedCurrent = currentAmp.clamp(0.0, maxScale);
    final double needleAngle = startAngle + (clampedCurrent / maxScale) * totalRange;

    // Puncak jarum menyentuh batas skala dalam (r=305)
    final pNeedleTip = polarToCartesian(cx, cy, 305.0 * scale, needleAngle);
    // Base jarum ditarik panjang dari bawah poros melewati pusat (r = -150) agar over menembus ke bawah di belakang panel
    final pNeedleBase = polarToCartesian(cx, cy, -150.0 * scale, needleAngle);

    // Garis Utama Jarum Merah Tebal
    final needlePaint = Paint()
      ..color = const Color(0xFFEF4444)
      ..strokeWidth = 2.4 * scale
      ..strokeCap = StrokeCap.round;

    canvas.drawLine(pNeedleBase, pNeedleTip, needlePaint);

    // Titik Indikator Merah Menyala di Dekat Ujung Jarum
    final pDot = polarToCartesian(cx, cy, 260.0 * scale, needleAngle);
    canvas.drawCircle(pDot, 5.0 * scale, Paint()..color = const Color(0xFFFF0033));
    canvas.drawCircle(pDot, 2.5 * scale, Paint()..color = Colors.white.withOpacity(0.9));
  }

  @override
  bool shouldRepaint(covariant _WaveformSampWhiteGaugePainter oldDelegate) {
    return oldDelegate.currentAmp != currentAmp;
  }
}

/// Custom Painter: Dual Waveform Logic (Volt Hijau Kotak di Atas & Curr Kuning di Bawah)
class _WaveformSampLogicPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    if (size.width <= 0 || size.height <= 0) return;

    // Garis Grid Horizontal Tipis
    final gridPaint = Paint()
      ..color = Colors.white.withOpacity(0.08)
      ..strokeWidth = 0.8;

    for (int i = 0; i <= 5; i++) {
      final y = size.height * (i / 5);
      canvas.drawLine(Offset(0, y), Offset(size.width, y), gridPaint);
    }

    // 1. Sinyal Atas: VOLT HIJAU (Gelombang Kotak Clock Rapat Simetris)
    final voltPath = Path();
    final double voltTopY = size.height * 0.08;
    final double voltBottomY = size.height * 0.44;
    const int voltCycles = 15;
    final double stepX = size.width / (voltCycles * 2);

    voltPath.moveTo(0, voltBottomY);
    for (int i = 0; i < voltCycles; i++) {
      final x1 = i * 2 * stepX;
      final x2 = x1 + stepX;
      final x3 = x2 + stepX;

      voltPath.lineTo(x1, voltTopY);
      voltPath.lineTo(x2, voltTopY);
      voltPath.lineTo(x2, voltBottomY);
      voltPath.lineTo(x3, voltBottomY);
    }

    final voltPaint = Paint()
      ..color = const Color(0xFF39FF14)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.0;

    canvas.drawPath(voltPath, voltPaint);

    // 2. Sinyal Bawah: CURR KUNING (Gelombang Pulsa Data Asimetris)
    final currPath = Path();
    final double currTopY = size.height * 0.52;
    final double currBottomY = size.height * 0.90;

    currPath.moveTo(0, currBottomY);

    // Pola Pulsa Data
    final pulses = [
      {'high': true, 'w': 0.22},
      {'high': false, 'w': 0.04},
      {'high': true, 'w': 0.05},
      {'high': false, 'w': 0.32},
      {'high': true, 'w': 0.15},
      {'high': false, 'w': 0.12},
      {'high': true, 'w': 0.10},
    ];

    double currentX = 0;
    for (final p in pulses) {
      final bool isHigh = p['high'] as bool;
      final double widthFrac = p['w'] as double;
      final double pulseWidth = size.width * widthFrac;
      final double targetY = isHigh ? currTopY : currBottomY;

      currPath.lineTo(currentX, targetY);
      currentX += pulseWidth;
      currPath.lineTo(currentX, targetY);
    }

    final currPaint = Paint()
      ..color = const Color(0xFFFFEB3B)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.0;

    canvas.drawPath(currPath, currPaint);
  }

  @override
  bool shouldRepaint(covariant _WaveformSampLogicPainter oldDelegate) => false;
}

/// Custom Painter Pengukur Arus Jarum Analog Default (Analog Ammeter Gauge)
class _AnalogMeterGaugePainter extends CustomPainter {
  final double currentAmp;
  final double maxAmp;
  final double ocpLimit;
  final Color accentColor;

  const _AnalogMeterGaugePainter({
    required this.currentAmp,
    required this.maxAmp,
    required this.ocpLimit,
    required this.accentColor,
  });

  @override
  void paint(Canvas canvas, Size size) {
    if (size.width <= 0 || size.height <= 0) return;

    final center = Offset(size.width / 2, size.height * 0.95);
    final radius = math.min(size.width * 0.48, size.height * 0.88);

    const startAngleDeg = 205.0;
    const sweepAngleDeg = 130.0;
    const startRad = startAngleDeg * (math.pi / 180.0);
    const totalRad = sweepAngleDeg * (math.pi / 180.0);

    final dialRect = Rect.fromCircle(center: center, radius: radius);
    final dialBgPaint = Paint()
      ..color = const Color(0xFF0D1117)
      ..style = PaintingStyle.fill;
    final dialArcPath = Path()
      ..moveTo(center.dx, center.dy)
      ..arcTo(dialRect, startRad, totalRad, false)
      ..close();
    canvas.drawPath(dialArcPath, dialBgPaint);

    final trackPaint = Paint()
      ..color = Colors.white24
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.5
      ..strokeCap = StrokeCap.round;
    canvas.drawArc(
      Rect.fromCircle(center: center, radius: radius),
      startRad,
      totalRad,
      false,
      trackPaint,
    );

    final clampedOcp = ocpLimit.clamp(0.0, maxAmp);
    final ocpFraction = clampedOcp / maxAmp;
    final ocpStartRad = startRad + (totalRad * ocpFraction);
    final ocpSweepRad = totalRad * (1.0 - ocpFraction);

    if (ocpSweepRad > 0) {
      final ocpPaint = Paint()
        ..color = Colors.redAccent.withOpacity(0.85)
        ..style = PaintingStyle.stroke
        ..strokeWidth = 3.5
        ..strokeCap = StrokeCap.round;
      canvas.drawArc(
        Rect.fromCircle(center: center, radius: radius),
        ocpStartRad,
        ocpSweepRad,
        false,
        ocpPaint,
      );
    }

    const totalDivisions = 50;
    for (int i = 0; i <= totalDivisions; i++) {
      final fraction = i / totalDivisions;
      final angle = startRad + (totalRad * fraction);
      final isMajor = (i % 10 == 0);
      final isMedium = (i % 5 == 0 && !isMajor);

      final tickLength = isMajor ? 9.0 : (isMedium ? 6.0 : 3.5);
      final tickColor = (fraction * maxAmp > clampedOcp)
          ? Colors.redAccent
          : (isMajor ? accentColor : (isMedium ? Colors.white60 : Colors.white30));

      final p1 = Offset(
        center.dx + (radius - 2) * math.cos(angle),
        center.dy + (radius - 2) * math.sin(angle),
      );
      final p2 = Offset(
        center.dx + (radius - 2 - tickLength) * math.cos(angle),
        center.dy + (radius - 2 - tickLength) * math.sin(angle),
      );

      final tickPaint = Paint()
        ..color = tickColor
        ..strokeWidth = isMajor ? 1.6 : (isMedium ? 1.1 : 0.7);

      canvas.drawLine(p1, p2, tickPaint);

      if (isMajor) {
        final val = fraction * maxAmp;
        final textSpan = TextSpan(
          text: val.toStringAsFixed(1),
          style: TextStyle(
            color: tickColor,
            fontSize: 8.0,
            fontWeight: FontWeight.bold,
            fontFamily: 'monospace',
          ),
        );
        final tp = TextPainter(
          text: textSpan,
          textDirection: TextDirection.ltr,
        )..layout();

        final labelRadius = radius - 18.0;
        final labelPos = Offset(
          center.dx + labelRadius * math.cos(angle) - (tp.width / 2),
          center.dy + labelRadius * math.sin(angle) - (tp.height / 2),
        );
        tp.paint(canvas, labelPos);
      }
    }

    final unitSpan = const TextSpan(
      text: 'AMPERE (MAX 1.0A)',
      style: TextStyle(
        color: Colors.white38,
        fontSize: 7.0,
        letterSpacing: 1.0,
        fontWeight: FontWeight.bold,
        fontFamily: 'monospace',
      ),
    );
    final unitTp = TextPainter(text: unitSpan, textDirection: TextDirection.ltr)..layout();
    unitTp.paint(canvas, Offset(center.dx - (unitTp.width / 2), center.dy - (radius * 0.45)));

    final clampedCurrent = currentAmp.clamp(0.0, maxAmp);
    final currentFraction = clampedCurrent / maxAmp;
    final needleAngle = startRad + (totalRad * currentFraction);

    final needleLength = radius * 0.88;
    final needleTip = Offset(
      center.dx + needleLength * math.cos(needleAngle),
      center.dy + needleLength * math.sin(needleAngle),
    );

    canvas.drawLine(
      Offset(center.dx + 2, center.dy + 2),
      Offset(needleTip.dx + 2, needleTip.dy + 2),
      Paint()..color = Colors.black.withOpacity(0.5)..strokeWidth = 2.5..strokeCap = StrokeCap.round,
    );

    final isOverLimit = clampedCurrent >= clampedOcp;
    final needleColor = isOverLimit ? Colors.redAccent : const Color(0xFFFF5252);
    canvas.drawLine(center, needleTip, Paint()..color = needleColor..strokeWidth = 2.0..strokeCap = StrokeCap.round);

    final tailTip = Offset(center.dx - 10 * math.cos(needleAngle), center.dy - 10 * math.sin(needleAngle));
    canvas.drawLine(center, tailTip, Paint()..color = Colors.white54..strokeWidth = 2.2..strokeCap = StrokeCap.round);

    canvas.drawCircle(center, 7.0, Paint()..color = const Color(0xFF1E2630));
    canvas.drawCircle(center, 7.0, Paint()..color = accentColor..style = PaintingStyle.stroke..strokeWidth = 1.2);
    canvas.drawCircle(center, 3.0, Paint()..color = needleColor);
  }

  @override
  bool shouldRepaint(covariant _AnalogMeterGaugePainter oldDelegate) {
    return oldDelegate.currentAmp != currentAmp ||
        oldDelegate.maxAmp != maxAmp ||
        oldDelegate.ocpLimit != ocpLimit ||
        oldDelegate.accentColor != accentColor;
  }
}

/// Custom Painter: Dark Dial Gauge 0 - 500 mA (Persis Script SVG HTML User)
/// Menggunakan matematika polar-to-cartesian persis:
/// cx = width/2, cy = height * 1.4137, startAngle = -46°, endAngle = 46°
/// rArc = 295/290 * height, rTickMinor = 303, rTickMid = 309, rTickMajor = 317, rText = 342
class _DarkAmmeterGaugePainter extends CustomPainter {
  final double currentmA;

  const _DarkAmmeterGaugePainter({
    required this.currentmA,
  });

  @override
  void paint(Canvas canvas, Size size) {
    if (size.width <= 0 || size.height <= 0) return;

    final double targetWidth = size.width * 0.90;
    final double scale = targetWidth / 495.0;

    final double cx = size.width / 2.0;

    final double rArc = 295.0 * scale;
    final double rTickStart = 295.0 * scale;
    final double rTickMinorEnd = 303.0 * scale;
    final double rTickMidEnd = 309.0 * scale;
    final double rTickMajorEnd = 317.0 * scale;
    final double rText = 344.0 * scale;

    // Kunci posisi teks teratas (200 & 300): pas tepat di bawah garis panel header (margin 18px)
    // Tidak terlalu bawah, pas tepat di bawah header
    final double cy = rText + 18.0;

    const double startAngle = -46.0;
    const double endAngle = 46.0;
    const double totalRange = endAngle - startAngle;

    // Helper: Polar to Cartesian (0 derajat di atas, searah jarum jam)
    Offset polarToCartesian(double centerX, double centerY, double radius, double angleInDegrees) {
      final double angleInRadians = (angleInDegrees - 90.0) * math.pi / 180.0;
      return Offset(
        centerX + (radius * math.cos(angleInRadians)),
        centerY + (radius * math.sin(angleInRadians)),
      );
    }

    // 1. Menggambar Garis Busur Utama (Arc)
    // Dalam sudut radian biasa: startAngle - 90 dan totalRange
    final double startRad = (startAngle - 90.0) * math.pi / 180.0;
    final double sweepRad = totalRange * math.pi / 180.0;

    final arcPaint = Paint()
      ..color = const Color(0xFFD4D4D4)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.5 * scale
      ..strokeCap = StrokeCap.round;

    canvas.drawArc(
      Rect.fromCircle(center: Offset(cx, cy), radius: rArc),
      startRad,
      sweepRad,
      false,
      arcPaint,
    );

    // 2. Menggambar Garis Ukur (Ticks) dan Angka Skala (0 s/d 500)
    const int totalTicks = 50;
    const double maxScale = 500.0;

    for (int i = 0; i <= totalTicks; i++) {
      final double angle = startAngle + (i / totalTicks) * totalRange;

      final bool isMajor = (i % 10 == 0); // 0, 100, 200, 300, 400, 500
      final bool isMid = (i % 5 == 0 && !isMajor); // 50, 150, 250, 350, 450

      final double rEnd = isMajor ? rTickMajorEnd : (isMid ? rTickMidEnd : rTickMinorEnd);

      final p1 = polarToCartesian(cx, cy, rTickStart, angle);
      final p2 = polarToCartesian(cx, cy, rEnd, angle);

      final tickPaint = Paint()
        ..color = Colors.white
        ..strokeWidth = (isMajor ? 2.5 : (isMid ? 1.8 : 1.2)) * scale
        ..strokeCap = StrokeCap.round;

      canvas.drawLine(p1, p2, tickPaint);

      // Angka Skala Utama (0, 100, 200, 300, 400, 500) Diperbesar
      if (isMajor) {
        final int val = ((i / 10) * 100).toInt();
        final pText = polarToCartesian(cx, cy, rText, angle);

        final tp = TextPainter(
          text: TextSpan(
            text: '$val',
            style: TextStyle(
              color: Colors.white,
              fontSize: 16.5 * scale, // Font angka diperbesar lebih tebal & jelas
              fontWeight: FontWeight.w900,
              fontFamily: 'monospace',
            ),
          ),
          textDirection: TextDirection.ltr,
        )..layout();

        // Rotasi angka selaras sudut busur persis seperti di SVG
        canvas.save();
        canvas.translate(pText.dx, pText.dy);
        canvas.rotate(angle * math.pi / 180.0);
        tp.paint(canvas, Offset(-tp.width / 2, -tp.height / 2));
        canvas.restore();
      }
    }

    // 3. Menggambar Jarum (Needle)
    final double clampedValue = currentmA.clamp(0.0, maxScale);
    final double needleAngle = startAngle + (clampedValue / maxScale) * totalRange;

    // Puncak jarum menyentuh batas skala dalam (r=305)
    final pNeedleTip = polarToCartesian(cx, cy, 305.0 * scale, needleAngle);
    // Base jarum ditarik panjang dari bawah poros melewati pusat (r = -150) agar over menembus ke bawah belakang panel grafik
    final pNeedleBase = polarToCartesian(cx, cy, -150.0 * scale, needleAngle);

    final needlePaint = Paint()
      ..color = const Color(0xFFF1F786) // Kuning neon persis HTML
      ..strokeWidth = 2.4 * scale
      ..strokeCap = StrokeCap.round;

    canvas.drawLine(pNeedleBase, pNeedleTip, needlePaint);
  }

  @override
  bool shouldRepaint(covariant _DarkAmmeterGaugePainter oldDelegate) {
    return oldDelegate.currentmA != currentmA;
  }
}

/// Custom Painter: Plot Grid Garis Horizontal Halus untuk Curve Ammeter
class _DarkCurveGraphPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    if (size.width <= 0 || size.height <= 0) return;

    // Grid Horizontal
    final gridPaint = Paint()
      ..color = Colors.white.withOpacity(0.06)
      ..strokeWidth = 0.8;

    const int divisions = 11;
    for (int i = 0; i <= divisions; i++) {
      final y = size.height * (i / divisions);
      canvas.drawLine(Offset(0, y), Offset(size.width, y), gridPaint);
    }
  }

  @override
  bool shouldRepaint(covariant _DarkCurveGraphPainter oldDelegate) => false;
}
