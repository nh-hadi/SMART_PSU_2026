import 'dart:math' as math;
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'theme.dart';

class PsuPanelView extends StatefulWidget {
  final Color activeColor;
  final Widget? oscilloscopeWidget;
  final double liveVolt;
  final double liveAmp;
  final bool ocpEnabled;
  final double ocpLimit;
  final Function(bool) onOcpEnabledChanged;
  final Function(double) onOcpLimitChanged;

  const PsuPanelView({
    super.key,
    required this.activeColor,
    this.oscilloscopeWidget,
    required this.liveVolt,
    required this.liveAmp,
    required this.ocpEnabled,
    required this.ocpLimit,
    required this.onOcpEnabledChanged,
    required this.onOcpLimitChanged,
  });

  @override
  State<PsuPanelView> createState() => _PsuPanelViewState();
}

class _PsuPanelViewState extends State<PsuPanelView> {
  final PageController _rootPageController = PageController();
  final PageController _subPageController = PageController();
  int _activeSubPageIndex = 0; // 0: DETAIL, 1: VOLT & AMP, 2: ANALOG AMMETER

  @override
  void dispose() {
    _rootPageController.dispose();
    _subPageController.dispose();
    super.dispose();
  }

  String _getSubPageTitle() {
    switch (_activeSubPageIndex) {
      case 0:
        return 'PSU: DETAIL LENGKAP';
      case 1:
        return 'PSU: VOLT & AMPERE JUMBO';
      case 2:
      default:
        return 'PSU: ANALOG AMMETER (1.0A)';
    }
  }

  @override
  Widget build(BuildContext context) {
    // Jika tidak ada oscilloscopeWidget yang dipass, tampilkan _buildSplitView langsung
    if (widget.oscilloscopeWidget == null) {
      return _buildPsuMiddlePanel();
    }

    return PageView(
      controller: _rootPageController,
      children: [
        // Halaman 1: Tampilan Standar (Panel 2 Kiri + Panel 3 Grafik Kanan)
        Row(
          children: [
            Expanded(
              flex: 4,
              child: _buildPsuMiddlePanel(),
            ),
            const SizedBox(width: 4),
            Expanded(
              flex: 6,
              child: widget.oscilloscopeWidget!,
            ),
          ],
        ),

        // Halaman 2: LAYAR PENUH PERSIS SEPERTI GAMBAR (Analog Meter + WaveFormSamp Logic)
        _buildWaveformSampFullscreenPanel(),

        // Halaman 3: LAYAR PENUH MULTI-INSTRUMENT DASHBOARD (Persis Gambar Referensi User)
        _buildDarkInstrumentDashboardPanel(),
      ],
    );
  }

  Widget _buildPsuMiddlePanel() {
    return Column(
      children: [
        // Indikator Sub-Halaman Geser Panel PSU + Tombol Fullscreen WaveFormSamp
        Container(
          padding: const EdgeInsets.symmetric(vertical: 2, horizontal: 6),
          margin: const EdgeInsets.only(bottom: 3),
          decoration: BoxDecoration(
            color: Colors.white.withOpacity(0.04),
            borderRadius: BorderRadius.circular(3),
            border: Border.all(color: Colors.white12, width: 0.6),
          ),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Row(
                children: [
                  Icon(Icons.swipe, color: widget.activeColor, size: 10),
                  const SizedBox(width: 4),
                  Text(
                    _getSubPageTitle(),
                    style: TextStyle(
                      color: widget.activeColor,
                      fontSize: 7.5,
                      fontFamily: 'monospace',
                      fontWeight: FontWeight.bold,
                      letterSpacing: 0.5,
                    ),
                  ),
                ],
              ),
              Row(
                mainAxisSize: MainAxisSize.min,
                children: [
                  Row(
                    mainAxisSize: MainAxisSize.min,
                    children: List.generate(3, (idx) {
                      final isActive = _activeSubPageIndex == idx;
                      return AnimatedContainer(
                        duration: const Duration(milliseconds: 200),
                        margin: const EdgeInsets.symmetric(horizontal: 2),
                        width: isActive ? 12 : 5,
                        height: 4,
                        decoration: BoxDecoration(
                          color: isActive ? widget.activeColor : Colors.white24,
                          borderRadius: BorderRadius.circular(2),
                        ),
                      );
                    }),
                  ),
                  if (widget.oscilloscopeWidget != null) ...[
                    const SizedBox(width: 6),
                    GestureDetector(
                      onTap: () {
                        _rootPageController.animateToPage(
                          1,
                          duration: const Duration(milliseconds: 300),
                          curve: Curves.easeInOut,
                        );
                      },
                      child: Container(
                        padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 1),
                        margin: const EdgeInsets.only(right: 3),
                        decoration: BoxDecoration(
                          color: Colors.white10,
                          border: Border.all(color: Colors.white24, width: 0.6),
                          borderRadius: BorderRadius.circular(2),
                        ),
                        child: const Text(
                          'P2',
                          style: TextStyle(color: Colors.white70, fontSize: 7, fontFamily: 'monospace', fontWeight: FontWeight.bold),
                        ),
                      ),
                    ),
                    GestureDetector(
                      onTap: () {
                        _rootPageController.animateToPage(
                          2,
                          duration: const Duration(milliseconds: 300),
                          curve: Curves.easeInOut,
                        );
                      },
                      child: Container(
                        padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 1),
                        decoration: BoxDecoration(
                          color: widget.activeColor.withOpacity(0.2),
                          border: Border.all(color: widget.activeColor, width: 0.8),
                          borderRadius: BorderRadius.circular(2),
                        ),
                        child: Text(
                          'P3 [UI]',
                          style: TextStyle(color: widget.activeColor, fontSize: 7, fontFamily: 'monospace', fontWeight: FontWeight.bold),
                        ),
                      ),
                    ),
                  ],
                ],
              ),
            ],
          ),
        ),

        // Area Display Utama (Bisa Di-swipe 3 Mode)
        Expanded(
          flex: 5,
          child: PageView(
            controller: _subPageController,
            onPageChanged: (idx) {
              setState(() => _activeSubPageIndex = idx);
            },
            children: [
              _buildPsuDefaultView(),
              _buildPsuVoltAmpOnlyView(),
              _buildPsuAnalogAmpView(),
            ],
          ),
        ),

        // 2B: Panel SET OCP + SLIDER MAX 10A (Hanya tampil pada Halaman 0 Standar)
        if (_activeSubPageIndex == 0) ...[
          const SizedBox(height: 4),
          AppTheme.buildPanel(
            height: 64,
            activeColor: widget.activeColor,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                SizedBox(
                  height: 24,
                  child: Row(
                    children: [
                      const Text(
                        'SET OCP',
                        style: TextStyle(
                          color: Colors.white,
                          fontSize: 9,
                          fontFamily: 'monospace',
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      const SizedBox(width: 6),
                      Text(
                        '${widget.ocpLimit.toStringAsFixed(1)}A / 10A',
                        style: const TextStyle(
                          color: Colors.white,
                          fontSize: 9,
                          fontFamily: 'monospace',
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      const Spacer(),
                      Text(
                        widget.ocpEnabled ? 'ON' : 'OFF',
                        style: TextStyle(
                          color: widget.ocpEnabled ? Colors.white : Colors.white38,
                          fontSize: 8.5,
                          fontFamily: 'monospace',
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      Transform.scale(
                        scale: 0.6,
                        child: Switch(
                          value: widget.ocpEnabled,
                          activeColor: Colors.white,
                          inactiveThumbColor: Colors.white38,
                          inactiveTrackColor: Colors.transparent,
                          onChanged: (val) {
                            HapticFeedback.mediumImpact();
                            widget.onOcpEnabledChanged(val);
                          },
                        ),
                      ),
                    ],
                  ),
                ),
                SizedBox(
                  height: 24,
                  child: SliderTheme(
                    data: SliderTheme.of(context).copyWith(
                      trackHeight: 2,
                      thumbShape: const RoundSliderThumbShape(enabledThumbRadius: 5),
                      overlayShape: SliderComponentShape.noOverlay,
                      activeTrackColor: Colors.white,
                      inactiveTrackColor: Colors.white24,
                      thumbColor: Colors.white,
                    ),
                    child: Slider(
                      value: widget.ocpLimit,
                      min: 0.0,
                      max: 10.0,
                      divisions: 100,
                      onChanged: (val) {
                        widget.onOcpLimitChanged(val);
                      },
                    ),
                  ),
                ),
              ],
            ),
          ),
        ],
        const SizedBox(height: 4),

        // 2C: Tombol Analisis AI
        AppTheme.buildPanel(
          height: 40,
          activeColor: widget.activeColor,
          child: Material(
            color: Colors.transparent,
            child: InkWell(
              onTap: () {
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(
                    duration: Duration(milliseconds: 1000),
                    content: Text('Trigger AI Analysis: Mengirim snapshot arus PSU...'),
                  ),
                );
              },
              child: Container(
                width: double.infinity,
                alignment: Alignment.center,
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: const [
                    Icon(Icons.auto_awesome, color: Colors.white, size: 14),
                    SizedBox(width: 6),
                    Text(
                      'PANEL 2C: [ START AI ANALYSIS ]',
                      style: TextStyle(
                        color: Colors.white,
                        fontSize: 9,
                        fontFamily: 'monospace',
                        fontWeight: FontWeight.bold,
                        letterSpacing: 0.5,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
        ),
      ],
    );
  }

  // ==========================================
  // LAYAR PENUH PERSIS SEPERTI GAMBAR USER
  // White Dial Gauge (0 - 2A, Red Center at 1A) + Digital 7-Seg Box + WaveFormSamp Dual Wave
  // ==========================================
  Widget _buildWaveformSampFullscreenPanel() {
    final double displayAmp = widget.liveAmp > 0 ? widget.liveAmp : 1.250;
    final double displayVolt = widget.liveVolt > 0 ? widget.liveVolt : 4.29;

    return Container(
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(4),
        border: Border.all(color: widget.activeColor.withOpacity(0.4), width: 1.0),
      ),
      clipBehavior: Clip.antiAlias,
      child: Column(
        children: [
          // ----------------------------------------
          // BAGIAN ATAS (PUTIH): ANALOG GAUGE 0 - 2A + 7-SEG DISPLAY
          // ----------------------------------------
          Expanded(
            flex: 10,
            child: Stack(
              children: [
                // 1. Lampu Indikator Hijau (Kiri Atas)
                Positioned(
                  top: 8,
                  left: 12,
                  child: Container(
                    width: 16,
                    height: 16,
                    decoration: BoxDecoration(
                      color: const Color(0xFF22C55E),
                      shape: BoxShape.circle,
                      boxShadow: [
                        BoxShadow(
                          color: const Color(0xFF22C55E).withOpacity(0.4),
                          blurRadius: 6,
                          spreadRadius: 2,
                        ),
                      ],
                    ),
                  ),
                ),

                // 2. Icon Gembok Terkunci (Kanan Atas) + Tombol Kembali
                Positioned(
                  top: 8,
                  right: 12,
                  child: Row(
                    children: [
                      GestureDetector(
                        onTap: () {
                          _rootPageController.animateToPage(
                            0,
                            duration: const Duration(milliseconds: 300),
                            curve: Curves.easeInOut,
                          );
                        },
                        child: Container(
                          padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 2),
                          decoration: BoxDecoration(
                            color: Colors.black.withOpacity(0.06),
                            borderRadius: BorderRadius.circular(3),
                          ),
                          child: const Icon(Icons.arrow_back, color: Colors.black87, size: 14),
                        ),
                      ),
                      const SizedBox(width: 6),
                      const Icon(Icons.lock, color: Colors.black87, size: 18),
                    ],
                  ),
                ),

                // 3. Canvas Busur Skala Analog Putih (0 s/d 2A) & Jarum Merah
                Positioned.fill(
                  child: CustomPaint(
                    painter: _WaveformSampWhiteGaugePainter(
                      currentAmp: displayAmp,
                    ),
                  ),
                ),

                // 4. Dua Box Nilai Tengah: [4.29] V  [5.00] A
                Positioned(
                  top: 50,
                  left: 0,
                  right: 0,
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      // Box Volt [ 4.29 ]
                      Container(
                        padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                        decoration: BoxDecoration(
                          color: const Color(0xFF1E293B),
                          borderRadius: BorderRadius.circular(3),
                        ),
                        child: Text(
                          displayVolt.toStringAsFixed(2),
                          style: const TextStyle(
                            color: Color(0xFF4ADE80),
                            fontSize: 11.5,
                            fontWeight: FontWeight.bold,
                            fontFamily: 'monospace',
                          ),
                        ),
                      ),
                      const SizedBox(width: 4),
                      const Text(
                        'V',
                        style: TextStyle(
                          color: Colors.black87,
                          fontSize: 12,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      const SizedBox(width: 14),

                      // Box OCP [ 5.00 ]
                      Container(
                        padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                        decoration: BoxDecoration(
                          color: const Color(0xFF1E293B),
                          borderRadius: BorderRadius.circular(3),
                        ),
                        child: Text(
                          widget.ocpLimit > 0 ? widget.ocpLimit.toStringAsFixed(2) : '5.00',
                          style: const TextStyle(
                            color: Color(0xFFFACC15),
                            fontSize: 11.5,
                            fontWeight: FontWeight.bold,
                            fontFamily: 'monospace',
                          ),
                        ),
                      ),
                      const SizedBox(width: 4),
                      const Text(
                        'A',
                        style: TextStyle(
                          color: Colors.black87,
                          fontSize: 12,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                ),

              ],
            ),
          ),

          // ----------------------------------------
          // BAGIAN BAWAH (HITAM): DUAL WAVEFORM (VOLT HIJAU KOTAK & CURR KUNING LOGIC)
          // ----------------------------------------
          Expanded(
            flex: 12,
            child: Container(
              color: Colors.black,
              child: Stack(
                children: [
                  // Label Header: VOLT O (Hijau) & O CURR (Kuning)
                  Positioned(
                    top: 2,
                    left: 50,
                    right: 50,
                    child: Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        Row(
                          children: const [
                            Text(
                              'VOLT',
                              style: TextStyle(
                                color: Color(0xFF39FF14),
                                fontSize: 11,
                                fontWeight: FontWeight.bold,
                                fontFamily: 'monospace',
                              ),
                            ),
                            SizedBox(width: 3),
                            Icon(Icons.circle_outlined, color: Color(0xFF39FF14), size: 9),
                          ],
                        ),
                        Row(
                          children: const [
                            Icon(Icons.circle_outlined, color: Color(0xFFFFEB3B), size: 9),
                            SizedBox(width: 3),
                            Text(
                              'CURR',
                              style: TextStyle(
                                color: Color(0xFFFFEB3B),
                                fontSize: 11,
                                fontWeight: FontWeight.bold,
                                fontFamily: 'monospace',
                              ),
                            ),
                          ],
                        ),
                      ],
                    ),
                  ),

                  // Sumbu Skala Voltase Kiri (10.00, 8.00, 6.00, 4.00, 2.00, 0.00)
                  Positioned(
                    top: 14,
                    bottom: 4,
                    left: 4,
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: const [
                        Text('10.00', style: TextStyle(color: Color(0xFF39FF14), fontSize: 9, fontFamily: 'monospace')),
                        Text('8.00', style: TextStyle(color: Color(0xFF39FF14), fontSize: 9, fontFamily: 'monospace')),
                        Text('6.00', style: TextStyle(color: Color(0xFF39FF14), fontSize: 9, fontFamily: 'monospace')),
                        Text('4.00', style: TextStyle(color: Color(0xFF39FF14), fontSize: 9, fontFamily: 'monospace')),
                        Text('2.00', style: TextStyle(color: Color(0xFF39FF14), fontSize: 9, fontFamily: 'monospace')),
                        Text('0.00', style: TextStyle(color: Color(0xFF39FF14), fontSize: 9, fontFamily: 'monospace')),
                      ],
                    ),
                  ),

                  // Sumbu Skala Arus Kanan (.005, .004, .003, .002, .001, .000)
                  Positioned(
                    top: 14,
                    bottom: 4,
                    right: 4,
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      crossAxisAlignment: CrossAxisAlignment.end,
                      children: const [
                        Text('.005', style: TextStyle(color: Color(0xFFFFEB3B), fontSize: 9, fontFamily: 'monospace')),
                        Text('.004', style: TextStyle(color: Color(0xFFFFEB3B), fontSize: 9, fontFamily: 'monospace')),
                        Text('.003', style: TextStyle(color: Color(0xFFFFEB3B), fontSize: 9, fontFamily: 'monospace')),
                        Text('.002', style: TextStyle(color: Color(0xFFFFEB3B), fontSize: 9, fontFamily: 'monospace')),
                        Text('.001', style: TextStyle(color: Color(0xFFFFEB3B), fontSize: 9, fontFamily: 'monospace')),
                        Text('.000', style: TextStyle(color: Color(0xFFFFEB3B), fontSize: 9, fontFamily: 'monospace')),
                      ],
                    ),
                  ),

                  // Custom Painter: Dual Waveform Logic persis gambar
                  Positioned.fill(
                    left: 36,
                    right: 36,
                    top: 14,
                    bottom: 6,
                    child: CustomPaint(
                      painter: _WaveformSampLogicPainter(),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  // Tampilan Halaman 0: Tampilan Standar 3 Baris (Volt, Ampere, Watt)
  Widget _buildPsuDefaultView() {
    final watt = widget.liveVolt * widget.liveAmp;
    final mA = widget.liveAmp * 1000.0;
    return Column(
      children: [
        Expanded(
          child: AppTheme.buildPanel(
            activeColor: widget.activeColor,
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Text(
                  'VOLTASE OUTPUT',
                  style: TextStyle(
                    color: Colors.white54,
                    fontSize: 8.5,
                    fontFamily: 'monospace',
                    fontWeight: FontWeight.bold,
                    letterSpacing: 0.5,
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  '${widget.liveVolt.toStringAsFixed(3)} V',
                  textAlign: TextAlign.center,
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 16,
                    fontFamily: 'monospace',
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
          ),
        ),
        const SizedBox(height: 4),
        Expanded(
          child: AppTheme.buildPanel(
            activeColor: widget.activeColor,
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Text(
                  'ARUS BEBAN (mA / A)',
                  style: TextStyle(
                    color: Colors.white54,
                    fontSize: 8.5,
                    fontFamily: 'monospace',
                    fontWeight: FontWeight.bold,
                    letterSpacing: 0.5,
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  '${mA.toStringAsFixed(1)} mA  /  ${widget.liveAmp.toStringAsFixed(3)} A',
                  textAlign: TextAlign.center,
                  style: TextStyle(
                    color: widget.activeColor,
                    fontSize: 13,
                    fontFamily: 'monospace',
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
          ),
        ),
        const SizedBox(height: 4),
        Expanded(
          child: AppTheme.buildPanel(
            activeColor: widget.activeColor,
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Text(
                  'KONSUMSI DAYA (WATT)',
                  style: TextStyle(
                    color: Colors.white54,
                    fontSize: 8.5,
                    fontFamily: 'monospace',
                    fontWeight: FontWeight.bold,
                    letterSpacing: 0.5,
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  '${watt.toStringAsFixed(3)} W',
                  textAlign: TextAlign.center,
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 15,
                    fontFamily: 'monospace',
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
          ),
        ),
      ],
    );
  }

  // Tampilan Halaman 1: Khusus Volt & Ampere Saja (Font Jumbo & Bersih)
  Widget _buildPsuVoltAmpOnlyView() {
    return Column(
      children: [
        Expanded(
          child: AppTheme.buildPanel(
            activeColor: widget.activeColor,
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: const [
                    Text(
                      'VOLTAGE',
                      style: TextStyle(
                        color: Colors.white60,
                        fontSize: 8.5,
                        fontFamily: 'monospace',
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    Text(
                      '0.000 - 30.000 V',
                      style: TextStyle(
                        color: Colors.white30,
                        fontSize: 7.5,
                        fontFamily: 'monospace',
                      ),
                    ),
                  ],
                ),
                const Spacer(),
                FittedBox(
                  fit: BoxFit.scaleDown,
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    crossAxisAlignment: CrossAxisAlignment.baseline,
                    textBaseline: TextBaseline.alphabetic,
                    children: [
                      Text(
                        widget.liveVolt.toStringAsFixed(3),
                        style: const TextStyle(
                          color: Colors.white,
                          fontSize: 34,
                          fontFamily: 'monospace',
                          fontWeight: FontWeight.bold,
                          letterSpacing: 1.0,
                        ),
                      ),
                      const SizedBox(width: 4),
                      const Text(
                        'V',
                        style: TextStyle(
                          color: Colors.white60,
                          fontSize: 16,
                          fontFamily: 'monospace',
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                ),
                const Spacer(),
              ],
            ),
          ),
        ),
        const SizedBox(height: 4),

        Expanded(
          child: AppTheme.buildPanel(
            activeColor: widget.activeColor,
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    const Text(
                      'CURRENT',
                      style: TextStyle(
                        color: Colors.white60,
                        fontSize: 8.5,
                        fontFamily: 'monospace',
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    Text(
                      '${(widget.liveAmp * 1000).toStringAsFixed(0)} mA',
                      style: const TextStyle(
                        color: Colors.white30,
                        fontSize: 7.5,
                        fontFamily: 'monospace',
                      ),
                    ),
                  ],
                ),
                const Spacer(),
                FittedBox(
                  fit: BoxFit.scaleDown,
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    crossAxisAlignment: CrossAxisAlignment.baseline,
                    textBaseline: TextBaseline.alphabetic,
                    children: [
                      Text(
                        widget.liveAmp.toStringAsFixed(3),
                        style: TextStyle(
                          color: widget.activeColor,
                          fontSize: 34,
                          fontFamily: 'monospace',
                          fontWeight: FontWeight.bold,
                          letterSpacing: 1.0,
                        ),
                      ),
                      const SizedBox(width: 4),
                      Text(
                        'A',
                        style: TextStyle(
                          color: widget.activeColor,
                          fontSize: 16,
                          fontFamily: 'monospace',
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                ),
                const Spacer(),
              ],
            ),
          ),
        ),
      ],
    );
  }

  // Tampilan Halaman 2: Analog Ampere Meter Jarum Tunggal (Skala Max 1.0A)
  Widget _buildPsuAnalogAmpView() {
    return AppTheme.buildPanel(
      activeColor: widget.activeColor,
      child: LayoutBuilder(
        builder: (context, constraints) {
          return Column(
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Row(
                    children: const [
                      Icon(Icons.speed, color: Colors.white70, size: 12),
                      SizedBox(width: 4),
                      Text(
                        'ANALOG AMMETER (1.0A MAX)',
                        style: TextStyle(
                          color: Colors.white,
                          fontSize: 8,
                          fontFamily: 'monospace',
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                  Container(
